# Copy this file to .env.local for local development.
# Set the same names as hosted Edge Function secrets with `supabase secrets set`.

# Generate long independent random values. Never expose either value to the browser.
OTP_HMAC_SECRET=replace-with-a-long-random-secret
CANCELLATION_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Use mock locally until Meta is available. The OTP appears only in function logs.
OTP_DELIVERY_MODE=mock

# Added during the WhatsApp proof stage.
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token

# Public website origin used in links and CORS checks.
APP_ORIGIN=http://localhost:5173
